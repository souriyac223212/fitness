@model FitWiseBD.Models.UserProfile

@using FitWiseBD.Models
@using System.Collections.Generic
@using System.Linq
@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";

    // =========================================================
    // USER INFORMATION
    // =========================================================

    string fullName = ViewBag.FullName ?? "User";
    string email = ViewBag.Email ?? "";


    // =========================================================
    // BMI
    // =========================================================

    double bmi = 0;

    if (ViewBag.BMI != null)
    {
        bmi = Convert.ToDouble(ViewBag.BMI);
    }

    string bmiStatus = ViewBag.BMIStatus ?? "Profile incomplete";


    // =========================================================
    // DAILY CALORIES
    // =========================================================

    double calories = 0;

    if (ViewBag.Calories != null)
    {
        calories = Convert.ToDouble(ViewBag.Calories);
    }


    // =========================================================
    // WORKOUT MINUTES
    // =========================================================

    int workoutMinutes = Model?.Weight.HasValue == true ? 30 : 0;

    if (ViewBag.WorkoutMinutes != null)
    {
        workoutMinutes = Convert.ToInt32(ViewBag.WorkoutMinutes);
    }


    // =========================================================
    // PROFILE STATUS
    // =========================================================

    bool hasProfile = false;

    if (ViewBag.HasProfile != null)
    {
        hasProfile = Convert.ToBoolean(ViewBag.HasProfile);
    }

    if (Model != null &&
        Model.Age.HasValue &&
        Model.Height.HasValue &&
        Model.Weight.HasValue &&
        !string.IsNullOrWhiteSpace(Model.FitnessGoal))
    {
        hasProfile = true;
    }


    // =========================================================
    // FITNESS GOAL
    // =========================================================

    string fitnessGoal = Model?.FitnessGoal ?? "";


    // =========================================================
    // WORKOUTS
    // =========================================================

    IEnumerable<Workout> recommendedWorkouts =
        Enumerable.Empty<Workout>();

    if (ViewBag.RecommendedWorkouts != null)
    {
        recommendedWorkouts =
            ViewBag.RecommendedWorkouts as IEnumerable<Workout>
            ?? Enumerable.Empty<Workout>();
    }


    // =========================================================
    // NUTRITION DATA
    // =========================================================

    IEnumerable<Food> breakfastFoods =
        Enumerable.Empty<Food>();

    IEnumerable<Food> lunchFoods =
        Enumerable.Empty<Food>();

    IEnumerable<Food> dinnerFoods =
        Enumerable.Empty<Food>();

    IEnumerable<Food> snacksFoods =
        Enumerable.Empty<Food>();


    if (ViewBag.BreakfastFoods != null)
    {
        breakfastFoods =
            ViewBag.BreakfastFoods as IEnumerable<Food>
            ?? Enumerable.Empty<Food>();
    }


    if (ViewBag.LunchFoods != null)
    {
        lunchFoods =
            ViewBag.LunchFoods as IEnumerable<Food>
            ?? Enumerable.Empty<Food>();
    }


    if (ViewBag.DinnerFoods != null)
    {
        dinnerFoods =
            ViewBag.DinnerFoods as IEnumerable<Food>
            ?? Enumerable.Empty<Food>();
    }


    if (ViewBag.SnacksFoods != null)
    {
        snacksFoods =
            ViewBag.SnacksFoods as IEnumerable<Food>
            ?? Enumerable.Empty<Food>();
    }


    // =========================================================
    // MEAL CALORIE CALCULATION
    // =========================================================

    double breakfastCalories =
        breakfastFoods.Sum(x => Convert.ToDouble(x.Calories));

    double lunchCalories =
        lunchFoods.Sum(x => Convert.ToDouble(x.Calories));

    double dinnerCalories =
        dinnerFoods.Sum(x => Convert.ToDouble(x.Calories));

    double snacksCalories =
        snacksFoods.Sum(x => Convert.ToDouble(x.Calories));


    // =========================================================
    // TOTAL NUTRITION CALORIES
    // =========================================================

    double totalNutritionCalories =
        breakfastCalories +
        lunchCalories +
        dinnerCalories +
        snacksCalories;


    // =========================================================
    // REMAINING CALORIES
    // =========================================================

    double remainingCalories =
        Math.Max(0, calories - totalNutritionCalories);


    // =========================================================
    // NEXT MEAL
    // =========================================================

    string nextMeal = "";

    if (breakfastCalories == 0)
    {
        nextMeal = "Breakfast";
    }
    else if (lunchCalories == 0)
    {
        nextMeal = "Lunch";
    }
    else if (dinnerCalories == 0)
    {
        nextMeal = "Dinner";
    }
    else if (snacksCalories == 0)
    {
        nextMeal = "Snacks";
    }
    else
    {
        nextMeal = "All meals logged";
    }
}


<style>

  /* =========================================================
   MAIN PAGE - FULL SCREEN WIDTH
========================================================= */

.dashboard-container {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 24px 30px;
    color: #21003d;
    box-sizing: border-box;
    animation: pageFadeIn .7s ease both;
}

    /* =========================================================
           ANIMATIONS
        ========================================================= */

    @@keyframes pageFadeIn {

        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes slideDown {

        from {
            opacity: 0;
            transform: translateY(-18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes slideUp {

        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes scaleIn {

        from {
            opacity: 0;
            transform: scale(.94);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }


    @@keyframes floatCircle {

        0%, 100% {
            transform: translateY(0) scale(1);
        }

        50% {
            transform: translateY(8px) scale(1.05);
        }
    }


    @@keyframes shimmer {

        0% {
            transform: translateX(-120%);
        }

        100% {
            transform: translateX(120%);
        }
    }


    @@keyframes softPulse {

        0%, 100% {
            opacity: .5;
            transform: scale(1);
        }

        50% {
            opacity: 1;
            transform: scale(1.25);
        }
    }


    /* =========================================================
           WELCOME BANNER
        ========================================================= */

    .welcome-banner {
        position: relative;
        overflow: hidden;
        background: #21003d;
        color: white;
        padding: 30px;
        border-radius: 20px;
        margin-bottom: 22px;
        animation: slideDown .7s ease both;
        box-shadow: 0 8px 25px rgba(33, 0, 61, .10);
    }


        .welcome-banner::after {
            content: "";
            position: absolute;
            left: -100%;
            top: 0;
            width: 60%;
            height: 100%;
            background: linear-gradient( 90deg, transparent, rgba(255,255,255,.06), transparent );
            animation: shimmer 5s infinite;
        }


        .welcome-banner h1 {
            position: relative;
            z-index: 2;
            margin: 0 0 8px 0;
            font-size: 25px;
            font-weight: 700;
        }


        .welcome-banner p {
            position: relative;
            z-index: 2;
            margin: 0;
            font-size: 13px;
            color: #eee;
        }


    .welcome-circle {
        position: absolute;
        width: 105px;
        height: 105px;
        right: -20px;
        top: -25px;
        background: #f19b88;
        border-radius: 50%;
        animation: floatCircle 4s ease-in-out infinite;
    }


    /* =========================================================
           STATISTICS
        ========================================================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 18px;
    }


    .stat-card {
        position: relative;
        overflow: hidden;
        background: white;
        border-radius: 15px;
        padding: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.06);
        opacity: 0;
        animation: scaleIn .55s ease forwards;
        transition: transform .25s ease, box-shadow .25s ease;
    }


        .stat-card:nth-child(1) {
            animation-delay: .15s;
        }


        .stat-card:nth-child(2) {
            animation-delay: .25s;
        }


        .stat-card:nth-child(3) {
            animation-delay: .35s;
        }


        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(33,0,61,.10);
        }


    .stat-title {
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 8px;
    }


    .stat-value {
        font-size: 22px;
        font-weight: 700;
        color: #21003d;
        margin-bottom: 3px;
    }


    .stat-subtitle {
        font-size: 10px;
        color: #777;
    }


    /* =========================================================
           MAIN TWO COLUMN SECTION
        ========================================================= */

    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 28px;
    }


    .dashboard-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 5px 18px rgba(0,0,0,.05);
        opacity: 0;
        animation: slideUp .65s ease forwards;
        transition: box-shadow .25s ease;
    }


        .dashboard-card:nth-child(1) {
            animation-delay: .45s;
        }


        .dashboard-card:nth-child(2) {
            animation-delay: .55s;
        }


        .dashboard-card:hover {
            box-shadow: 0 10px 26px rgba(33,0,61,.08);
        }


    .card-title {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 15px;
    }


    /* =========================================================
           WORKOUT
        ========================================================= */

    .workout-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 11px 0;
        border-bottom: 1px solid #eee;
        font-size: 12px;
        opacity: 0;
        animation: slideUp .45s ease forwards;
    }


        .workout-row:nth-child(2) {
            animation-delay: .55s;
        }


        .workout-row:nth-child(3) {
            animation-delay: .65s;
        }


        .workout-row:nth-child(4) {
            animation-delay: .75s;
        }


        .workout-row:last-of-type {
            border-bottom: none;
        }


        .workout-row strong {
            display: block;
            font-size: 13px;
            margin-bottom: 3px;
        }


        .workout-row small {
            color: #777;
            font-size: 10px;
        }


    .workout-stats {
        color: #21003d;
        font-size: 11px;
        font-weight: 600;
    }


    /* =========================================================
           BUTTON
        ========================================================= */

    .view-btn {
        position: relative;
        overflow: hidden;
        display: inline-block;
        margin-top: 13px;
        background: #21003d;
        color: white;
        text-decoration: none;
        padding: 9px 17px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
    }


        .view-btn::after {
            content: "";
            position: absolute;
            top: 0;
            left: -100%;
            width: 70%;
            height: 100%;
            background: linear-gradient( 90deg, transparent, rgba(255,255,255,.18), transparent );
            transition: left .45s ease;
        }


        .view-btn:hover::after {
            left: 130%;
        }


        .view-btn:hover {
            background: #35005f;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(33,0,61,.18);
        }


        .view-btn:active {
            transform: scale(.96);
        }


    /* =========================================================
           TODAY'S NUTRITION SUMMARY
        ========================================================= */

    .nutrition-summary-card {
        position: relative;
        overflow: hidden;
    }


    .nutrition-summary-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }


        .nutrition-summary-header .card-title {
            margin-bottom: 0;
        }


    .nutrition-status-dot {
        width: 8px;
        height: 8px;
        background: #f19b88;
        border-radius: 50%;
        box-shadow: 0 0 0 5px rgba(241,155,136,.12);
        animation: softPulse 2.5s ease-in-out infinite;
    }


    /* =========================================================
           MEAL SUMMARY
        ========================================================= */

    .nutrition-meal-summary {
        margin-top: 3px;
    }


    .nutrition-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 0;
        font-size: 11px;
        color: #333;
        transition: transform .2s ease, padding-left .2s ease;
    }


        .nutrition-summary-row:hover {
            padding-left: 5px;
            transform: translateX(2px);
        }


        .nutrition-summary-row span {
            font-weight: 500;
        }


        .nutrition-summary-row strong {
            color: #21003d;
            font-size: 11px;
        }


    /* =========================================================
           DIVIDER
        ========================================================= */

    .nutrition-divider {
        height: 1px;
        background: #ddd;
        margin: 7px 0;
    }


    /* =========================================================
           TOTAL
        ========================================================= */

    .nutrition-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        font-size: 12px;
        color: #21003d;
    }


        .nutrition-total-row span {
            font-weight: 700;
        }


        .nutrition-total-row strong {
            font-size: 13px;
            font-weight: 700;
        }


    /* =========================================================
           NEXT MEAL
        ========================================================= */

    .next-meal-box {
        margin-top: 13px;
        padding: 11px 12px;
        border-radius: 10px;
        background: #faf7fc;
        border-left: 3px solid #21003d;
        transition: transform .2s ease, box-shadow .2s ease;
    }


        .next-meal-box:hover {
            transform: translateX(3px);
            box-shadow: 0 4px 12px rgba(33,0,61,.06);
        }


    .next-meal-title {
        color: #21003d;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 5px;
    }


    .next-meal-box p {
        margin: 0 0 5px;
        font-size: 10px;
        color: #555;
    }


        .next-meal-box p strong {
            color: #21003d;
        }


    .remaining-calories {
        font-size: 10px;
        color: #777;
    }


        .remaining-calories strong {
            color: #21003d;
        }


    /* =========================================================
           NUTRITION DETAILS BUTTON
        ========================================================= */

    .nutrition-details-btn {
        position: relative;
        overflow: hidden;
        display: inline-block;
        margin-top: 13px;
        padding: 9px 15px;
        border-radius: 20px;
        background: #21003d;
        color: white;
        text-decoration: none;
        font-size: 10px;
        font-weight: 600;
        transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    }


        .nutrition-details-btn::after {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 70%;
            height: 100%;
            background: linear-gradient( 90deg, transparent, rgba(255,255,255,.18), transparent );
            transition: left .45s ease;
        }


        .nutrition-details-btn:hover::after {
            left: 130%;
        }


        .nutrition-details-btn:hover {
            background: #35005f;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(33,0,61,.18);
        }


        .nutrition-details-btn:active {
            transform: scale(.96);
        }


    /* =========================================================
           RECOMMENDED FOR YOU
        ========================================================= */

    .recommendation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        animation: slideUp .6s ease .7s both;
    }


        .recommendation-header h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 500;
        }


        .recommendation-header p {
            margin: 4px 0 0;
            font-size: 10px;
            color: #777;
        }


    .view-all-btn {
        background: #21003d;
        color: white;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        transition: transform .2s ease, box-shadow .2s ease;
    }


        .view-all-btn:hover {
            background: #35005f;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(33,0,61,.16);
        }


    /* =========================================================
           GOAL BANNER
        ========================================================= */

    .goal-banner {
        position: relative;
        overflow: hidden;
        background: #21003d;
        color: white;
        padding: 16px;
        border-radius: 12px;
        margin-bottom: 14px;
        animation: slideUp .6s ease .8s both;
    }


        .goal-banner::after {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            right: -35px;
            top: -50px;
            border-radius: 50%;
            background: rgba(241,155,136,.18);
            animation: floatCircle 5s ease-in-out infinite;
        }


        .goal-banner h3 {
            position: relative;
            z-index: 2;
            margin: 0 0 5px;
            font-size: 13px;
        }


        .goal-banner p {
            position: relative;
            z-index: 2;
            margin: 0;
            font-size: 10px;
            color: #ddd;
        }


    /* =========================================================
           RECOMMENDATION CARDS
        ========================================================= */

    .recommendation-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
    }


    .recommendation-card {
        position: relative;
        background: white;
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,.06);
        opacity: 0;
        animation: scaleIn .5s ease forwards;
        transition: transform .25s ease, box-shadow .25s ease;
    }


        .recommendation-card:nth-child(1) {
            animation-delay: .85s;
        }


        .recommendation-card:nth-child(2) {
            animation-delay: .95s;
        }


        .recommendation-card:nth-child(3) {
            animation-delay: 1.05s;
        }


        .recommendation-card:nth-child(4) {
            animation-delay: 1.15s;
        }


        .recommendation-card:nth-child(5) {
            animation-delay: 1.25s;
        }


        .recommendation-card:nth-child(6) {
            animation-delay: 1.35s;
        }


        .recommendation-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(33,0,61,.10);
        }


    .recommendation-icon {
        font-size: 27px;
        margin-bottom: 8px;
    }


    .recommendation-card h3 {
        margin: 0 0 8px;
        font-size: 17px;
        font-weight: 600;
    }


    .workout-type {
        display: inline-block;
        background: #f3e7ff;
        color: #21003d;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 600;
    }


    .recommendation-info {
        margin-top: 13px;
        font-size: 11px;
        line-height: 1.8;
    }


    .workout-view-btn {
        display: inline-block;
        margin-top: 12px;
        background: #eee7f5;
        color: #21003d;
        text-decoration: none;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 600;
        transition: transform .2s ease, background .2s ease;
    }


        .workout-view-btn:hover {
            background: #21003d;
            color: white;
            transform: translateX(3px);
        }


    /* =========================================================
           NO RECOMMENDATION
        ========================================================= */

    .no-recommendation {
        background: white;
        padding: 35px;
        border-radius: 16px;
        text-align: center;
        box-shadow: 0 5px 18px rgba(0,0,0,.05);
        animation: scaleIn .6s ease both;
    }


        .no-recommendation h3 {
            margin: 0 0 8px;
            font-size: 17px;
        }


        .no-recommendation p {
            margin: 0;
            color: #777;
            font-size: 11px;
        }


    /* =========================================================
           RESPONSIVE
        ========================================================= */

    @@media (max-width: 850px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }


        .dashboard-grid {
            grid-template-columns: 1fr;
        }


        .recommendation-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 550px) {

        .dashboard-container {
            padding: 0 12px;
        }


        .recommendation-grid {
            grid-template-columns: 1fr;
        }


        .recommendation-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }


        .welcome-banner {
            padding: 24px;
        }


            .welcome-banner h1 {
                font-size: 21px;
            }
    }


    /* =========================================================
           REDUCE MOTION
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
        }
    }

</style>


<!-- =========================================================
     DASHBOARD
========================================================= -->

<div class="dashboard-container">


    <!-- =====================================================
         WELCOME
    ====================================================== -->

    <div class="welcome-banner">

        <div class="welcome-circle"></div>

        <h1>
            Welcome to FitWise BD 👋
        </h1>

        <p>
            Hello, @fullName! Your personal fitness and nutrition dashboard.
        </p>

    </div>


    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <div class="stats-grid">


        <!-- BMI -->

        <div class="stat-card">

            <div class="stat-title">
                ⚖️ BMI
            </div>

            <div class="stat-value">

                @if (bmi > 0)
                {
                    @bmi.ToString("0.0")
                }
                else
                {
                    @:--
                }

            </div>

            <div class="stat-subtitle">
                @bmiStatus
            </div>

        </div>


        <!-- DAILY CALORIES -->

        <div class="stat-card">

            <div class="stat-title">
                🔥 Daily Calories
            </div>

            <div class="stat-value">

                @if (calories > 0)
                {
                    @calories.ToString("0")
                }
                else
                {
                    @:--
                }

            </div>

            <div class="stat-subtitle">
                kcal / day
            </div>

        </div>


        <!-- WORKOUT -->

        <div class="stat-card">

            <div class="stat-title">
                🏃 Workout
            </div>

            <div class="stat-value">
                @workoutMinutes
            </div>

            <div class="stat-subtitle">
                @(ViewBag.WorkoutMinutes != null ? "minutes today" : "suggested daily activity")
            </div>

        </div>

    </div>


    <!-- =====================================================
         WORKOUT + NUTRITION
    ====================================================== -->

    <div class="dashboard-grid">


        <!-- =================================================
             TODAY'S WORKOUT
        ================================================== -->

        <div class="dashboard-card">

            <div class="card-title">
                🏃 Today's Workout
            </div>


            @if (hasProfile && recommendedWorkouts.Any())
            {

                foreach (var workout in recommendedWorkouts.Take(3))
                {

                    <div class="workout-row">

                        <div>

                            <strong>
                                @workout.Name
                            </strong>

                            <small>
                                @workout.Type
                            </small>

                        </div>


                        <div class="workout-stats">

                            @if (workout.Sets.HasValue)
                            {
                                @workout.Sets
                                <span> × </span>
                            }

                            @if (workout.Reps.HasValue)
                            {
                                @workout.Reps
                            }

                        </div>

                    </div>

                }


