@model FitWiseBD.Models.UserProfile?

@{
    ViewData["Title"] = "Dashboard";
    Layout = null;

    double bmi = 0;
    double calories = 0;

    if (ViewBag.BMI != null)
    {
        double.TryParse(ViewBag.BMI.ToString(), out bmi);
    }

    if (ViewBag.Calories != null)
    {
        double.TryParse(ViewBag.Calories.ToString(), out calories);
    }

    string bmiStatus = ViewBag.BMIStatus?.ToString() ?? "";

    string fullName = ViewBag.FullName?.ToString() ?? "User";

    int workoutMinutes = 45;

    if (ViewBag.WorkoutMinutes != null)
    {
        int.TryParse(
            ViewBag.WorkoutMinutes.ToString(),
            out workoutMinutes
        );
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>FitWise BD - Dashboard</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f7f5f8;
            color: #21003d;
        }

        /* =========================
           NAVBAR
        ========================= */

        .navbar {
            height: 70px;
            background: #21003d;
            color: white;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 45px;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            align-items: center;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 15px;
        }

        .nav-links a:hover {
            opacity: 0.8;
        }

        /* =========================
           LOGOUT BUTTON
        ========================= */

        .logout {
            background: #efa08e;
            color: #21003d;

            padding: 10px 20px;

            border: none;
            border-radius: 20px;

            font-weight: bold;
            font-size: 15px;

            cursor: pointer;
        }

        .logout:hover {
            background: #f5b09f;
        }

        /* =========================
           MAIN
        ========================= */

        .container {
            max-width: 1200px;

            margin: auto;

            padding: 40px 25px;
        }

        /* =========================
           WELCOME
        ========================= */

        .welcome {
            background: #21003d;

            color: white;

            padding: 35px;

            border-radius: 25px;

            position: relative;

            overflow: hidden;
        }

        .welcome h1 {
            font-size: 34px;
            margin-bottom: 10px;
        }

        .welcome p {
            color: #ddd;
            font-size: 17px;
        }

        .circle {
            position: absolute;

            width: 180px;
            height: 180px;

            background: #efa08e;

            border-radius: 50%;

            right: -50px;
            top: -80px;
        }

        /* =========================
           PROFILE WARNING
        ========================= */

        .profile-warning {
            background: #fff3cd;

            color: #856404;

            padding: 15px 20px;

            border-radius: 12px;

            margin-top: 20px;

            text-align: center;
        }

        .profile-warning a {
            color: #21003d;
            font-weight: bold;
        }

        /* =========================
           CARDS
        ========================= */

        .cards {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 20px;

            margin-top: 30px;
        }

        .card {
            background: white;

            padding: 25px;

            border-radius: 20px;

            box-shadow:
                0 5px 20px
                rgba(0,0,0,0.06);
        }

        .card h3 {
            font-size: 17px;

            margin-bottom: 15px;
        }

        .value {
            font-size: 32px;

            font-weight: bold;

            color: #21003d;
        }

        .unit {
            color: #777;

            font-size: 14px;
        }

        /* =========================
           SECTIONS
        ========================= */

        .sections {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 25px;

            margin-top: 30px;
        }

        .section {
            background: white;

            padding: 25px;

            border-radius: 20px;
        }

        .section h2 {
            margin-bottom: 20px;
        }

        .item {
            display: flex;

            justify-content: space-between;

            padding: 15px 0;

            border-bottom:
                1px solid #eee;
        }

        .item:last-child {
            border-bottom: none;
        }

        .btn {
            display: inline-block;

            margin-top: 20px;

            background: #21003d;

            color: white;

            text-decoration: none;

            padding: 12px 25px;

            border-radius: 25px;
        }

        .btn:hover {
            opacity: 0.9;
        }

        /* =========================
           MOBILE
        ========================= */

        @@media (max-width: 800px) {

            .navbar {
                padding: 0 20px;
            }

            .nav-links {
                gap: 10px;
            }

            .nav-links a {
                display: none;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .sections {
                grid-template-columns: 1fr;
            }

            .welcome h1 {
                font-size: 28px;
            }

            .container {
                padding: 25px 15px;
            }
        }

    </style>

</head>

<body>

    <!-- =========================
         NAVBAR
    ========================= -->

    <nav class="navbar">

        <div class="logo">
            FitWise BD
        </div>

        <div class="nav-links">

            <a href="/Home">
                Dashboard
            </a>

            <a href="/Foods">
                Nutrition
            </a>

            <a href="#">
                Workout
            </a>

            <a href="#">
                BMI
            </a>

            <a href="/UserProfile">
                Profile
            </a>

            <!-- LOGOUT -->
            <form asp-controller="Auth"
                  asp-action="Logout"
                  method="post"
                  style="display:inline; margin:0;">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="logout">

                    Logout

                </button>

            </form>

        </div>

    </nav>


    <!-- =========================
         MAIN CONTENT
    ========================= -->

    <main class="container">


        <!-- =========================
             WELCOME
        ========================= -->

        <div class="welcome">

            <div class="circle"></div>

            <h1>
                Welcome to FitWise BD 👋
            </h1>

            <p>

                Hello,

                <strong>
                    @fullName
                </strong>!

                Your personal fitness
                and nutrition dashboard.

            </p>

        </div>


        <!-- =========================
             PROFILE WARNING
        ========================= -->

        @if (Model == null ||
             !Model.Age.HasValue ||
             !Model.Height.HasValue ||
             !Model.Weight.HasValue)
        {
            <div class="profile-warning">

                Please complete your

                <a href="/UserProfile">
                    profile
                </a>

                to calculate BMI
                and daily calories.

            </div>
        }


        <!-- =========================
             SUMMARY CARDS
        ========================= -->

        <div class="cards">


            <!-- =========================
                 BMI
            ========================= -->

            <div class="card">

                <h3>
                    ⚖️ BMI
                </h3>

                <div class="value">

                    @if (bmi > 0)
                    {
                        @bmi.ToString("0.0")
                    }
                    else
                    {
                        @:--
                    }

                </div>

                <span class="unit">

                    @if (!string.IsNullOrWhiteSpace(bmiStatus))
                    {
                        @bmiStatus
                    }
                    else
                    {
                        @:Complete profile
                    }

                </span>

            </div>


            <!-- =========================
                 DAILY CALORIES
            ========================= -->

            <div class="card">

                <h3>
                    🔥 Daily Calories
                </h3>

                <div class="value">

                    @if (calories > 0)
                    {
                        @calories.ToString("0")
                    }
                    else
                    {
                        @:--
                    }

                </div>

                <span class="unit">
                    kcal / day
                </span>

            </div>


            <!-- =========================
                 WORKOUT
            ========================= -->

            <div class="card">

                <h3>
                    🏃 Workout
                </h3>

                <div class="value">
                    @workoutMinutes
                </div>

                <span class="unit">
                    minutes today
                </span>

            </div>

        </div>


        <!-- =========================
             LOWER SECTIONS
        ========================= -->

        <div class="sections">


            <!-- =========================
                 WORKOUT
            ========================= -->

            <div class="section">

                <h2>
                    Today's Workout
                </h2>

                <div class="item">

                    <span>
                        Push Ups
                    </span>

                    <strong>
                        3 × 15
                    </strong>

                </div>

                <div class="item">

                    <span>
                        Squats
                    </span>

                    <strong>
                        3 × 20
                    </strong>

                </div>

                <div class="item">

                    <span>
                        Plank
                    </span>

                    <strong>
                        3 × 45 sec
                    </strong>

                </div>

                <a href="#"
                   class="btn">

                    View Workout

                </a>

            </div>


            <!-- =========================
                 NUTRITION
            ========================= -->

            <div class="section">

                <h2>
                    Today's Nutrition
                </h2>

                <div class="item">

                    <span>
                        Breakfast
                    </span>

                    <strong>
                        450 kcal
                    </strong>

                </div>

                <div class="item">

                    <span>
                        Lunch
                    </span>

                    <strong>
                        650 kcal
                    </strong>

                </div>

                <div class="item">

                    <span>
                        Dinner
                    </span>

                    <strong>
                        550 kcal
                    </strong>

                </div>

                <a href="/Foods"
                   class="btn">

                    View Nutrition

                </a>

            </div>

        </div>

    </main>

</body>

</html>