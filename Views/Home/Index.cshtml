    <!-- ACTIVITY BAR CHART -->

    <div class="activity-bars">

        @foreach (var day in weeklyActivity)
        {
            var barHeight = day.Minutes > 0
                ? Math.Max(
                    4,
                    (int)Math.Round(
                        day.Minutes * 100.0 / maxMinutes
                    )
                )
                : 0;

            <div class="activity-bar-item">

                <span class="activity-bar-value">
                    @day.Minutes min
                </span>

                <div class="activity-bar-track">

                    <div class="activity-bar-fill"
                         style="height: @(barHeight)%;">

                    </div>

                </div>

                <span class="activity-bar-date">
                    @day.Date.ToString("ddd")
                </span>

                @if (day.Minutes == 0)
                {
                    <small>No activity recorded</small>
                }
                else
                {
                    <small>@day.Sessions session(s)</small>
                }

            </div>
        }

