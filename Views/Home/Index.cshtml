               @if (weightLogs.Any())
{
    <div class="weight-chart-wrap">
        <svg class="weight-chart"
             viewBox="0 0 640 220"
             role="img"
             aria-label="Weight trend chart">

            <defs>
                <linearGradient id="weightAreaGradient"
                                x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%"
                          stop-color="#7c3aed"
                          stop-opacity="0.24" />
                    <stop offset="100%"
                          stop-color="#7c3aed"
                          stop-opacity="0.01" />
                </linearGradient>
            </defs>

            <line x1="48" y1="45" x2="592" y2="45"
                  class="chart-gridline" />
            <line x1="48" y1="85" x2="592" y2="85"
                  class="chart-gridline" />
            <line x1="48" y1="125" x2="592" y2="125"
                  class="chart-gridline" />
            <line x1="48" y1="170" x2="592" y2="170"
                  class="chart-axis" />

            <text x="5" y="49" class="chart-axis-label">
                @chartMaxWeight.ToString("0.0")
            </text>

            <text x="5" y="129" class="chart-axis-label">
                @(((chartMinWeight + chartMaxWeight) / 2.0).ToString("0.0"))
            </text>

            <text x="5" y="174" class="chart-axis-label">
                @chartMinWeight.ToString("0.0")
            </text>

            @if (weightLogs.Count > 1)
            {
                var areaPoints = "48,170 " + weightChartPoints + " 592,170";

                <polygon points="@areaPoints"
                         fill="url(#weightAreaGradient)" />

                <polyline points="@weightChartPoints"
                          class="weight-chart-line" />
            }

            @for (int i = 0; i < weightLogs.Count; i++)
            {
                double pointX = weightLogs.Count == 1
                    ? 320
                    : 48 + i * (544.0 / (weightLogs.Count - 1));

                double pointY = 170 -
                    ((weightLogs[i].Weight!.Value - chartMinWeight)
                    / chartWeightRange) * 125;

                string xCoordinate =
                    pointX.ToString("0.##", CultureInfo.InvariantCulture);

                string yCoordinate =
                    pointY.ToString("0.##", CultureInfo.InvariantCulture);

                string labelY =
                    Math.Max(20, pointY - 12)
                    .ToString("0.##", CultureInfo.InvariantCulture);

                string weightLabel =
                    weightLogs[i].Weight!.Value.ToString("0.0");

                string dateLabel =
                    weightLogs[i].LogDate.ToString("dd MMM");

                <circle cx="@xCoordinate"
                        cy="@yCoordinate"
                        r="5"
                        class="weight-chart-point" />

               <svg:text x="@xCoordinate"
          y="@labelY"
          text-anchor="middle"
          class="chart-point-label">@weightLabel</svg:text>

<svg:text x="@xCoordinate"
          y="197"
          text-anchor="middle"
          class="chart-date-label">@dateLabel</svg:text>
            }
        </svg>
    </div>
}
else
{
