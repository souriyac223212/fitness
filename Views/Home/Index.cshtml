    <!-- DASHBOARD: PROGRESS CHART SUMMARY ONLY -->
@{
    var progressLogs = ViewBag.ProgressLogs as IEnumerable<FitWiseBD.Models.ProgressLog>
        ?? Enumerable.Empty<FitWiseBD.Models.ProgressLog>();

    // Latest progress record
    var latestProgress = progressLogs
        .OrderByDescending(p => p.LogDate)
        .ThenByDescending(p => p.Id)
        .FirstOrDefault();

    // Fitness goal
    var profileForProgress = Model;

    string progressGoal = string.IsNullOrWhiteSpace(profileForProgress?.FitnessGoal)
        ? "Your Fitness Journey"
        : profileForProgress.FitnessGoal;

    // Last 7 calendar days
    var today = DateTime.Today;
    var weekStart = today.AddDays(-6);

    var weeklyActivity = Enumerable.Range(0, 7)
        .Select(offset =>
        {
            var date = weekStart.AddDays(offset);

            var dayLogs = progressLogs
                .Where(p => p.LogDate.Date == date)
                .ToList();

            return new
            {
                Date = date,
                Minutes = dayLogs.Sum(p => p.WorkoutMinutes),
                Sessions = dayLogs.Sum(p => p.WorkoutSessions)
            };
        })
        .ToList();

    // Weekly statistics
    int totalWeeklyMinutes = weeklyActivity.Sum(x => x.Minutes);

    int totalWeeklySessions = weeklyActivity
    .Where(x => x.Minutes > 0)
    .Count();

    int activeDays = weeklyActivity.Count(x => x.Minutes > 0);

    int maxMinutes = Math.Max(
        1,
        weeklyActivity.Max(x => x.Minutes)
    );

    // Weight chart: retain the existing weight history
    var weightLogs = progressLogs
        .Where(p => p.Weight.HasValue)
        .OrderBy(p => p.LogDate)
        .ThenBy(p => p.Id)
        .TakeLast(7)
        .ToList();

    double minWeight = weightLogs.Any()
        ? weightLogs.Min(p => p.Weight!.Value)
        : 0;

    double maxWeight = weightLogs.Any()
        ? weightLogs.Max(p => p.Weight!.Value)
        : 0;

    double weightPadding = Math.Max(
        1.0,
        (maxWeight - minWeight) * 0.15
    );

    double chartMinWeight = minWeight - weightPadding;
    double chartMaxWeight = maxWeight + weightPadding;

    double chartWeightRange = Math.Max(
        1.0,
        chartMaxWeight - chartMinWeight
    );

    string weightChartPoints = string.Join(
        " ",
        weightLogs.Select((p, i) =>
        {
            double x = weightLogs.Count == 1
                ? 320
                : 48 + i * (544.0 / (weightLogs.Count - 1));

            double y = 170 -
                ((p.Weight!.Value - chartMinWeight) / chartWeightRange) * 125;

            return x.ToString("0.##", CultureInfo.InvariantCulture)
                + ","
                + y.ToString("0.##", CultureInfo.InvariantCulture);
        })
    );
}

