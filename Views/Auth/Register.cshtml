@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>FitWise BD - Sign Up</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;

            display: flex;
            justify-content: center;
            align-items: center;

            min-height: 100vh;
        }

        .card {
            width: 420px;
            min-height: 820px;

            background: #21003d;

            border-radius: 28px;

            position: relative;
            overflow: hidden;

            padding: 50px 42px;

            color: white;
        }

        .top {
            position: absolute;

            top: -65px;
            right: -45px;

            width: 185px;
            height: 185px;

            background: #efa08e;

            border-radius: 50%;
        }

        .bottom {
            position: absolute;

            bottom: -125px;
            left: -60px;

            width: 540px;
            height: 220px;

            background: #efa08e;

            border-radius: 50%;
        }

        .content {
            position: relative;

            z-index: 2;
        }

        h1 {
            font-size: 48px;

            margin-bottom: 8px;
        }

        .subtitle {
            font-size: 20px;

            color: #eeeeee;

            margin-bottom: 65px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        input {
            width: 100%;

            height: 58px;

            padding: 0 20px;

            border: none;

            border-radius: 30px;

            outline: none;

            font-size: 16px;

            background: white;

            color: #111;
        }

        input:focus {
            box-shadow: 0 0 0 2px #efa08e;
        }

        button {
            width: 100%;

            height: 58px;

            margin-top: 18px;

            border: none;

            border-radius: 30px;

            background: #12001f;

            color: white;

            font-size: 16px;

            font-weight: bold;

            cursor: pointer;
        }

        button:hover {
            background: #35005f;
        }

        button:disabled {
            opacity: 0.6;

            cursor: not-allowed;
        }

        .login {
            text-align: center;

            margin-top: 25px;

            font-size: 15px;
        }

        .login a {
            color: white;

            font-weight: bold;
        }

        #message {
            position: relative;

            z-index: 5;

            margin-top: 18px;

            text-align: center;

            font-size: 16px;

            line-height: 1.4;
        }

        .error {
            color: white;
        }

        .success {
            color: #90ee90;
        }
    </style>
</head>

<body>

    <div class="card">

        <div class="top"></div>

        <div class="bottom"></div>


        <div class="content">

            <h1>Sign Up</h1>

            <p class="subtitle">
                Hello! Let's join with us
            </p>


            <form id="registerForm">

                <!-- Full Name -->

                <div class="form-group">

                    <input
                        type="text"
                        id="fullName"
                        placeholder="Full Name"
                        autocomplete="name"
                        required />

                </div>


                <!-- Email -->

                <div class="form-group">

                    <input
                        type="email"
                        id="email"
                        placeholder="Email"
                        autocomplete="email"
                        required />

                </div>


                <!-- Password -->

                <div class="form-group">

                    <input
                        type="password"
                        id="password"
                        placeholder="Password"
                        autocomplete="new-password"
                        required />

                </div>


                <!-- Confirm Password -->

                <div class="form-group">

                    <input
                        type="password"
                        id="confirmPassword"
                        placeholder="Confirm Password"
                        autocomplete="new-password"
                        required />

                </div>


                <!-- Submit -->

                <button
                    type="submit"
                    id="registerButton">

                    SIGN UP

                </button>

            </form>


            <!-- Message -->

            <p id="message"></p>


            <!-- Login -->

            <div class="login">

                Already have an account?

                <a href="/Auth/Login">
                    Sign in
                </a>

            </div>

        </div>

    </div>


    <script>

        const form =
            document.getElementById("registerForm");

        const message =
            document.getElementById("message");

        const button =
            document.getElementById("registerButton");


        form.addEventListener(
            "submit",
            async function (event) {

                event.preventDefault();


                message.textContent = "";

                message.className = "";


                const fullName =
                    document
                        .getElementById("fullName")
                        .value
                        .trim();


                const email =
                    document
                        .getElementById("email")
                        .value
                        .trim();


                const password =
                    document
                        .getElementById("password")
                        .value;


                const confirmPassword =
                    document
                        .getElementById("confirmPassword")
                        .value;


                // ==========================
                // CLIENT SIDE VALIDATION
                // ==========================

                if (fullName.length === 0) {

                    showError(
                        "Please enter your full name."
                    );

                    return;
                }


                if (email.length === 0) {

                    showError(
                        "Please enter your email."
                    );

                    return;
                }


                if (password.length < 6) {

                    showError(
                        "Password must be at least 6 characters."
                    );

                    return;
                }


                // Identity requires a digit

                if (!/[0-9]/.test(password)) {

                    showError(
                        "Password must contain at least one digit."
                    );

                    return;
                }


                if (password !== confirmPassword) {

                    showError(
                        "Passwords do not match."
                    );

                    return;
                }


                // ==========================
                // DISABLE BUTTON
                // ==========================

                button.disabled = true;

                button.textContent =
                    "CREATING ACCOUNT...";


                try {

                    // ==========================
                    // SEND TO ASP.NET API
                    // ==========================

                    const response =
                        await fetch(
                            "/api/auth/register",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({

                                    fullName:
                                        fullName,

                                    email:
                                        email,

                                    password:
                                        password,

                                    confirmPassword:
                                        confirmPassword

                                })
                            }
                        );


                    // ==========================
                    // READ RESPONSE
                    // ==========================

                    const data =
                        await response.json();


                    // ==========================
                    // ERROR
                    // ==========================

                    if (!response.ok) {

                        let errorMessage =
                            "Registration failed.";


                        if (data.message) {

                            errorMessage =
                                data.message;
                        }


                        if (data.errors) {

                            if (
                                Array.isArray(
                                    data.errors
                                )
                            ) {

                                errorMessage =
                                    data.errors.join(
                                        " "
                                    );

                            }
                            else {

                                errorMessage =
                                    Object.values(
                                        data.errors
                                    )
                                    .flat()
                                    .join(" ");
                            }
                        }


                        // Show database/server error
                        if (
                            data.innerError
                        ) {

                            errorMessage +=
                                " " +
                                data.innerError;
                        }


                        showError(
                            errorMessage
                        );


                        resetButton();

                        return;
                    }


                    // ==========================
                    // SUCCESS
                    // ==========================

                    showSuccess(
                        "Registration successful!"
                    );


                    // Redirect to Login

                    setTimeout(
                        function () {

                            window.location.href =
                                "/Auth/Login";

                        },
                        1000
                    );


                }
                catch (error) {

                    console.error(
                        "Registration error:",
                        error
                    );


                    showError(
                        "Unable to connect to the server."
                    );


                    resetButton();
                }

            }
        );


        // ==========================
        // ERROR FUNCTION
        // ==========================

        function showError(text) {

            message.textContent = text;

            message.className =
                "error";
        }


        // ==========================
        // SUCCESS FUNCTION
        // ==========================

        function showSuccess(text) {

            message.textContent = text;

            message.className =
                "success";
        }


        // ==========================
        // RESET BUTTON
        // ==========================

        function resetButton() {

            button.disabled = false;

            button.textContent =
                "SIGN UP";
        }

    </script>

</body>
</html>