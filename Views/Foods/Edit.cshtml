@model FitWiseBD.Models.Food

@{
    ViewData["Title"] = "Edit Food";
}

<div class="container mt-5">

    <div class="card shadow-sm border-0 p-4">

        <h2>✏️ Edit Food</h2>

        <p class="text-muted">
            Update food information.
        </p>

        <hr />

        <form asp-action="Edit" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <input type="hidden"
                   asp-for="FoodId" />


            <div class="mb-3">

                <label asp-for="Name"
                       class="form-label">
                    Food Name
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="MealType"
                       class="form-label">
                    Meal
                </label>

                <select asp-for="MealType"
                        class="form-select">

                    <option value="">
                        Select Meal
                    </option>

                    <option value="Breakfast">
                        🌅 Breakfast
                    </option>

                    <option value="Lunch">
                        ☀️ Lunch
                    </option>

                    <option value="Dinner">
                        🌙 Dinner
                    </option>

                </select>

            </div>


            <div class="mb-3">

                <label asp-for="Calories"
                       class="form-label">
                    Calories
                </label>

                <input asp-for="Calories"
                       class="form-control"
                       type="number"
                       step="0.1"
                       min="0" />

            </div>


            <div class="row">

                <div class="col-md-4 mb-3">

                    <label asp-for="Protein"
                           class="form-label">
                        Protein (g)
                    </label>

                    <input asp-for="Protein"
                           class="form-control"
                           type="number"
                           step="0.1"
                           min="0" />

                </div>


                <div class="col-md-4 mb-3">

                    <label asp-for="Carbs"
                           class="form-label">
                        Carbs (g)
                    </label>

                    <input asp-for="Carbs"
                           class="form-control"
                           type="number"
                           step="0.1"
                           min="0" />

                </div>


                <div class="col-md-4 mb-3">

                    <label asp-for="Fat"
                           class="form-label">
                        Fat (g)
                    </label>

                    <input asp-for="Fat"
                           class="form-control"
                           type="number"
                           step="0.1"
                           min="0" />

                </div>

            </div>


            <div class="mb-3">

                <label asp-for="Cost"
                       class="form-label">
                    Cost
                </label>

                <input asp-for="Cost"
                       class="form-control"
                       type="number"
                       step="0.1"
                       min="0" />

            </div>


            <button type="submit"
                    class="btn btn-dark">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}